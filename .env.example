# ==============================================================================
# VIRALITY LAB ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# LLM Provider Selection: "mock" (default, zero keys), "nvidia", "openai", "gemini", "anthropic", or "ollama"
VIRALITY_LAB_LLM_PROVIDER=mock
VIRALITY_LAB_LLM_MODEL=

# NVIDIA NIM / AI Foundation API Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
